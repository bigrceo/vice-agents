# Public site URL (metadata, OG, Pons logo URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:4083

# Robinhood Chain RPC override (optional; defaults to the official RPC + PublicNode fallback)
NEXT_PUBLIC_RPC_URL=
RPC_URLS=

# Platform wallet (EVM private key). Pays the Pons launch fee (0.0005 ETH) + gas of every sponsored launch.
# Empty or underfunded: the creator's wallet sends the exact same launch itself.
PLATFORM_PRIVATE_KEY=

# Postgres (separate from the Solana getclip.fun DB). Empty = demo data.
DATABASE_URL=

# Media storage (Vercel Blob). Empty = local .data/ folder (dev only).
BLOB_READ_WRITE_TOKEN=

PONS_LAUNCH_CONFIG_ID=0
CREATOR_TAX_BPS=0
LAUNCHES_PER_IP_PER_DAY=5
# 1 = simulate launches (eth_call), send nothing.
LAUNCH_DRY_RUN=1

# The platform coin, once live on Pons
NEXT_PUBLIC_OFFICIAL_TOKEN=
NEXT_PUBLIC_OFFICIAL_TICKER=

NEXT_PUBLIC_GOOGLE_MAPS_KEY=
