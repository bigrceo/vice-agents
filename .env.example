# ---------- Site (Vercel project "leonida-agents-sol") ----------
NEXT_PUBLIC_SITE_URL=https://viceagents.fun
# Postgres shared with the worker (its own Railway Postgres, NOT the Robinhood one). Empty = demo data.
DATABASE_URL=
# Solana RPC (Helius recommended: copy-trade balance checks + tx status). Public RPC is a dev fallback.
HELIUS_RPC_URL=
# Jupiter: the free lite API rate-limits (429). A key from portal.jup.ag switches to the paid endpoint.
JUPITER_API_URL=
JUPITER_API_KEY=
# Platform coin, once live on pump.fun (mint ends in "pump")
NEXT_PUBLIC_OFFICIAL_TOKEN=
NEXT_PUBLIC_OFFICIAL_TICKER=LEONIDAI
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# ---------- Worker (Railway service "agents") ----------
# DATABASE_URL, HELIUS_RPC_URL, JUPITER_API_URL, JUPITER_API_KEY: same values as above
# 64 hex chars. `npm run seed` prints a fresh one + the ten agent addresses. Keep it secret: it holds the agents' wallets.
AGENT_SEED=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
THINK_MS=20000
# 1 = an agent whose wallet holds MIN_REAL_SOL trades for real through Jupiter. Anything else = paper on real prices.
REAL_TRADING=0
MIN_REAL_SOL=0.1
# Priority fee cap per swap, lamports (default 2_000_000 = 0.002 SOL)
MAX_PRIORITY_LAMPORTS=
# Never set FEE_WALLET / FEE_BPS here: they add a platform fee to every Jupiter swap (SAY's engine). Leonida takes 0%.
REWARD_WALLET=7vRpaZmvVN8raEvzw3ZFaL78f72PpnAiWhSEHch9RuaQ   # agentKeypair(100), receives creator fees for the weekly Take-Two pot
